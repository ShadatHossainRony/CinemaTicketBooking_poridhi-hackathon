# ─────────────────────────────────────────────────────────────────────────────
# CinemaSeat — environment variables.
# .env is OPTIONAL. Defaults in docker-compose.yml make `docker compose up` work
# from a clean clone with no .env (REQ-21). This file exists for the VM and
# for developers who want to override.
# Never commit a real .env — REQ-58.
# ─────────────────────────────────────────────────────────────────────────────

# --- App -----------------------------------------------------------------
APP_NAME=cinemaseat-api
APP_VERSION=0.1.0
ENVIRONMENT=local            # local | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Booking rules — REQ-19 lives here ------------------------------------
# Judges will restart the stack with a small value to watch a hold expire.
HOLD_TTL_SECONDS=120
PAYMENT_WINDOW_SECONDS=90
SWEEP_INTERVAL_SECONDS=5
RECONCILE_INTERVAL_SECONDS=30
MAX_SEATS_PER_HOLD=6

# --- OTP -----------------------------------------------------------------
OTP_REQUIRED=true            # escape hatch if the gateway's code is unobtainable
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Database (dev defaults; on the VM these are regenerated) -----------
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=cinemaseat_dev_pw
POSTGRES_DB=cinemaseat
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10

# --- Gateway (the provided container — REQ-08) ----------------------------
GATEWAY_BASE_URL=http://gateway:9000
GATEWAY_CALLBACK_URL=http://api:8000/payments/callback
GATEWAY_TIMEOUT_SECONDS=5.0
GATEWAY_HEALTH_TIMEOUT_SECONDS=1.0
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_RESET_SECONDS=30
# Per payment_gateway.md, GATEWAY_SECRET default is "z2p-2026-secret".
# The gateway signs every callback with this secret. We verify the HMAC
# before accepting any webhook body.
GATEWAY_SECRET=z2p-2026-secret
# Flip to false only for local debugging with a mock that doesn't sign.
GATEWAY_SIGNATURE_REQUIRED=true

# --- Rate limiting --------------------------------------------------------
# Must NOT shed Scenario A's 100-request burst.
RATE_LIMIT_HOLD_PER_MINUTE=120
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# --- Sessions (INF-08) ----------------------------------------------------
SESSION_SECRET=replace-me-on-vm-with-openssl-rand-hex-32
